    <script src="js/slick.min.js"></script>
    <script src="js/main.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            var slickCarousels = ['#top-selling-slick', '#new-arrivals-slick', '#wc-slick', '#laliga-slick', '#premier-slick', '#seriea-slick', '#bundesliga-slick', '#ligueone-slick'];

            slickCarousels.forEach(function (id) {
                var $target = $(id);

                // Si ya fue inicializado por main.js, lo destruimos temporalmente
                if ($target.hasClass('slick-initialized')) {
                    $target.slick('unslick');
                }

                // Cuenta cuántas tarjetas de camisetas hay dentro de este contenedor
                var totalCamisetas = $target.children().length;

                if (totalCamisetas > 0) {
                    var mostrarFlechas = (totalCamisetas > 4);

                    $target.slick({
                        dots: false,
                        infinite: false,
                        slidesToShow: 4,
                        slidesToScroll: 1,
                        arrows: mostrarFlechas,
                        prevArrow: '<button type="button" class="offside-prev">&#10094;</button>',
                        nextArrow: '<button type="button" class="offside-next">&#10095;</button>',
                        responsive: [
                            {
                                breakpoint: 1024,
                                settings: {
                                    slidesToShow: 3,
                                    slidesToScroll: 1,
                                    arrows: (totalCamisetas > 3)
                                }
                            },
                            {
                                breakpoint: 768,
                                settings: {
                                    slidesToShow: 1,
                                    slidesToScroll: 1,
                                    arrows: (totalCamisetas > 1)
                                }
                            }
                        ]
                    });
                }
            });
        });
       
    </script>
